      "name": "Start calibration",
      "description": "Starts a run with the current selection."
    },
    "cancel": {
      "name": "Cancel calibration",
      "description": "Cancels the run, offsets stay unchanged."
    },
    "dismiss": {
      "name": "Close result",
      "description": "Closes the result view."
    },
    "rollback": {
      "name": "Undo",
      "description": "Restores offsets and precision from before the last run."
    },
    "restore_offsets": {
      "name": "Restore offsets",
      "description": "Writes the stored offsets again when they are missing or differ in Zigbee2MQTT, for example after a sensor was reset."
