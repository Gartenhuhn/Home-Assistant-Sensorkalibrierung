{
  "title": "Zigbee2MQTT Sensor Calibration",
  "config": {
    "abort": {
      "single_instance_allowed": "Sensor calibration is already set up."
    },
    "step": {
      "user": {
        "title": "Zigbee2MQTT Sensor Calibration",
        "description": "Calibrates Zigbee2MQTT sensors placed side by side. Add the card custom:sensor-kalibrierung-card to a dashboard.",
        "data": {
          "base_topic": "Zigbee2MQTT base topic"
        }
      }
    }
  },
  "options": {
